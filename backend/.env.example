# OAuth client secrets — WAJIB diisi lewat Railway Variables atau .env lokal (mode 600).
# JANGAN pernah mengisi nilai riil di file ini; file ini ikut ter-commit.
# Nilai kosong = provider OAuth tersebut nonaktif (tidak error, hanya tidak bisa connect).

# Gemini / gemini-cli (Google OAuth2)
GEMINI_CLIENT_SECRET=

# iFlow (Authorization Code)
IFLOW_CLIENT_SECRET=

# Antigravity (Google OAuth2)
ANTIGRAVITY_CLIENT_SECRET=

# Origin browser yang BOLEH membaca respons ber-credential (/api/* memakai cookie sesi).
# Pisahkan dengan koma. Kosong = semua origin browser ditolak; CLI/SDK/curl tetap jalan
# karena mereka tidak mengirim header Origin.
# Contoh: CORS_ALLOWED_ORIGINS=https://app.domain-anda.com,https://admin.domain-anda.com
CORS_ALLOWED_ORIGINS=
