JWT_SECRET=${{secret(32)}}
INITIAL_PASSWORD=${{secret(32)}}
DATA_DIR=/data
# Optional. When set, PostgreSQL replaces SQLite as the primary database.
# DATABASE_URL=postgresql://user:password@host:5432/router
PORT=20128
NODE_ENV=production
API_KEY_SECRET=${{secret(32)}}
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
CLOUD_URL=https://cloud.example.com
NEXT_PUBLIC_CLOUD_URL=https://cloud.example.com
INSTANCE_NAME=SYNS4033Router

# NOTE: there is no REQUIRE_API_KEY variable. The API-key requirement is a
# dashboard setting, not an env var, and it defaults to ON: an unset value
# would otherwise let every /v1 handler through and turn the gateway into an
# open relay as soon as one provider key is added. Change it under
# Settings -> Security -> Require API key, or mint a key under Endpoint.

# OPTIONAL: Outbound proxy for upstream provider connections.
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
